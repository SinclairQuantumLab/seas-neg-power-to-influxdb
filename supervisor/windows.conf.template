; Copy into the Windows Supervisor conf.d directory after replacing paths if needed.
[program:seas-neg-power-to-influxdb]
command="C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -ExecutionPolicy Bypass -File "%(ENV_USERPROFILE)s\Projects\seas-neg-power-to-influxdb\Startup.ps1"
directory="%(ENV_USERPROFILE)s\Projects\seas-neg-power-to-influxdb"
process_name=%(program_name)s
autostart=true
; Longer than persistent connection-failure exit (~20 s at 1 s polling / 3 s timeout).
startsecs=30
startretries=5
autorestart=unexpected
stdout_logfile=%(here)s\logs\%(program_name)s_out.log
stdout_logfile_maxbytes=2MB
stdout_logfile_backups=2
stderr_logfile=%(here)s\logs\%(program_name)s_err.log
stderr_logfile_maxbytes=5MB
stderr_logfile_backups=2
